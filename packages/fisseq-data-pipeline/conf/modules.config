// Per-process settings of the shared modules (packages/fisseq-common/nextflow/modules/local/
// <stage>/main.nf) as this pipeline runs them: the pipeline-specific config fields (ext.args)
// and publish paths. Every module calls its fisseq-common entry point
// (python -m fisseq_common.stages.<stage>) and carries everything both pipelines pass alike.
// The publish paths are fisseq_common.layout.DataPipelineLayout's
// (tests/unit/test_publish_layout.py checks).
//
// A cell is identified by (meta_cell_index, meta_variant_tag), the stages' default join_keys:
// QC_FILTER assigns meta_cell_index from the raw input row order.
//
// ext.args closures see the process's inputs (batch_stem, rep, method, ...).

process {
    // Raw starcall column names; every cell gets a meta_cell_index.
    withName: 'QC_FILTER' {
        ext.args = {
            [
                'barcode_col_name=upBarcode',
                'aa_changes_col_name=aaChanges',
                'edit_distance_col_name=editDistance',
                "'sort_output_by=[meta_cell_index,meta_variant_tag]'",
                'assign_cell_index=true',
            ].join(' ')
        }
        publishDir = [path: { "${params.pipeline_dir}/qc_filter/${batch_stem}" }, mode: 'copy']
    }

    // The shared FILTER module; `cells` and `qc_passed` are the same filtered_cells file,
    // which has no batch column of its own.
    withName: 'NORMALIZE' {
        ext.args = { "batch_name=${batch_stem}" }
        publishDir = [path: { "${params.pipeline_dir}/normalization/${batch_stem}" }, mode: 'copy']
    }

    withName: 'OVWT_BATCHWISE' {
        publishDir = [path: { "${params.pipeline_dir}/ovwt_batchwise/${batch_stem}" }, mode: 'copy']
    }

    // The shared AGGREGATE module, three ways.
    // Stage 1: full aggregates, z-scored against the experiment's synonymous variants.
    withName: 'AGGREGATE_FEATURE_TYPE_BATCHWISE' {
        ext.args = { "downsample_wt=${params.feature_select_downsample_wt} normalize_to_synonymous=true" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/aggregates" }, mode: 'copy']
    }
    // Stage 1b: passthrough aggregates stay raw (p-values keep their own scale).
    withName: 'AGGREGATE_FEATURE_TYPE_PASSTHROUGH' {
        ext.args = { "downsample_wt=${params.feature_select_downsample_wt} normalize_to_synonymous=false" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/passthrough_aggregates" }, mode: 'copy']
    }
    // Stage 2b: one bootstrap half. With feature_select_downsample_wt set, every half of
    // every replicate draws an independent wildtype subsample: the seed is derived from
    // (rep, half).
    withName: 'AGGREGATE_HALF_BATCHWISE' {
        ext.args = { "downsample_wt=${params.feature_select_downsample_wt}" }
        ext.seed = { (params.random_seed as int) + (rep as int) * 2 + (half as int) }
        publishDir = [
            path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/half_aggregates/bootstrap_${rep}/${method}" },
            mode: 'copy',
            saveAs: { _filename -> "half${half}_agg.parquet" },
        ]
    }

    withName: 'GENERATE_SPLIT_BATCHWISE' {
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/splits/bootstrap_${rep}" }, mode: 'copy']
    }

    withName: 'CORRELATE_FEATURES_BATCHWISE' {
        publishDir = [
            path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/correlations/${method}" },
            mode: 'copy',
            saveAs: { _filename -> "bootstrap_${rep}.parquet" },
        ]
    }

    withName: 'BLOCKLIST_BATCHWISE' {
        ext.args = { "minimum_correlation=${params.feature_select_min_correlation}" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/blocklists" }, mode: 'copy']
    }

    withName: 'COMBINE_BLOCKLISTS_BATCHWISE' {
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}" }, mode: 'copy']
    }

    withName: 'FINALIZE_FEATURE_SELECT_BATCHWISE' {
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}" }, mode: 'copy']
    }
}
