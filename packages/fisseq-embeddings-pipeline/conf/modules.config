// Per-process settings of the shared modules (packages/fisseq-common/nextflow/modules/local/
// <stage>/main.nf) as this pipeline runs them: the pipeline-specific config fields (ext.args)
// and publish paths. Every module calls its fisseq-common entry point
// (python -m fisseq_common.stages.<stage>) and carries everything both pipelines pass alike.
//
// The process names, parameters and publish paths are fisseq-data-pipeline's; the publish
// paths are fisseq_common.layout.EmbeddingsPipelineLayout's (tests/unit/test_publish_layout.py
// checks). What differs from the data pipeline:
//   - a cell is identified by (meta_batch, meta_well, meta_tile, meta_cell_index):
//     meta_cell_index is the cell's index within its tile;
//   - the cellDINO track's features are the emb_NNNN dimensions (feature_selector=embeddings);
//   - the CellProfiler-feature track (*_CP_FEATURES) publishes under *_cp_features
//     directories.
//
// ext.args closures see the process's inputs (batch_stem, rep, method, ...).

process {
    // BUILD_CELL_METADATA's columns already have their meta_* names (QC_FILTER's defaults).
    withName: 'QC_FILTER' {
        ext.args = "'sort_output_by=[meta_batch,meta_well,meta_tile,meta_cell_index,meta_variant_tag]'"
        publishDir = [path: { "${params.pipeline_dir}/qc_filter/${batch_stem}" }, mode: 'copy']
    }

    // ── cellDINO track ──────────────────────────────────────────────────────

    // The shared FILTER module: EMBED_CELLS' embeddings and QC_FILTER's filtered_cells.
    withName: 'NORMALIZE' {
        ext.args = "'join_keys=[meta_batch,meta_well,meta_tile,meta_cell_index]'"
        publishDir = [path: { "${params.pipeline_dir}/normalization/${batch_stem}" }, mode: 'copy']
    }

    withName: 'OVWT_BATCHWISE' {
        ext.args = "'join_keys=[meta_batch,meta_well,meta_tile,meta_cell_index]' feature_selector=embeddings"
        publishDir = [path: { "${params.pipeline_dir}/ovwt_batchwise/${batch_stem}" }, mode: 'copy']
    }

    // The shared AGGREGATE module, three ways.
    // Stage 1: full aggregates, z-scored against the experiment's synonymous variants.
    withName: 'AGGREGATE_FEATURE_TYPE_BATCHWISE' {
        ext.args = { "'join_keys=[meta_batch,meta_well,meta_tile,meta_cell_index]' feature_selector=embeddings downsample_wt=${params.feature_select_downsample_wt} normalize_to_synonymous=true" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/aggregates" }, mode: 'copy']
    }
    // Stage 1b: passthrough aggregates stay raw (p-values keep their own scale).
    withName: 'AGGREGATE_FEATURE_TYPE_PASSTHROUGH' {
        ext.args = { "'join_keys=[meta_batch,meta_well,meta_tile,meta_cell_index]' feature_selector=embeddings downsample_wt=${params.feature_select_downsample_wt} normalize_to_synonymous=false" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/passthrough_aggregates" }, mode: 'copy']
    }
    // Stage 2b: one bootstrap half; the seed is derived from (rep, half).
    withName: 'AGGREGATE_HALF_BATCHWISE' {
        ext.args = { "'join_keys=[meta_batch,meta_well,meta_tile,meta_cell_index]' feature_selector=embeddings downsample_wt=${params.feature_select_downsample_wt}" }
        ext.seed = { (params.random_seed as int) + (rep as int) * 2 + (half as int) }
        publishDir = [
            path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/half_aggregates/bootstrap_${rep}/${method}" },
            mode: 'copy',
            saveAs: { _filename -> "half${half}_agg.parquet" },
        ]
    }

    withName: 'GENERATE_SPLIT_BATCHWISE' {
        ext.args = "'join_keys=[meta_batch,meta_well,meta_tile,meta_cell_index]'"
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/splits/bootstrap_${rep}" }, mode: 'copy']
    }

    withName: 'CORRELATE_FEATURES_BATCHWISE' {
        publishDir = [
            path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/correlations/${method}" },
            mode: 'copy',
            saveAs: { _filename -> "bootstrap_${rep}.parquet" },
        ]
    }

    withName: 'BLOCKLIST_BATCHWISE' {
        ext.args = { "minimum_correlation=${params.feature_select_min_correlation}" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/blocklists" }, mode: 'copy']
    }

    withName: 'COMBINE_BLOCKLISTS_BATCHWISE' {
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}" }, mode: 'copy']
    }

    withName: 'FINALIZE_FEATURE_SELECT_BATCHWISE' {
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}" }, mode: 'copy']
    }

    // ── CellProfiler-feature track ──────────────────────────────────────────

    withName: 'NORMALIZE_CP_FEATURES' {
        ext.args = "'join_keys=[meta_batch,meta_well,meta_tile,meta_cell_index]'"
        publishDir = [path: { "${params.pipeline_dir}/normalization_cp_features/${batch_stem}" }, mode: 'copy']
    }

    withName: 'AGGREGATE_FEATURE_TYPE_CP_FEATURES' {
        ext.args = { "'join_keys=[meta_batch,meta_well,meta_tile,meta_cell_index]' feature_selector=features downsample_wt=${params.feature_select_downsample_wt} normalize_to_synonymous=true" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise_cp_features/${batch_stem}/aggregates" }, mode: 'copy']
    }

    withName: 'OVWT_BATCHWISE_CP_FEATURES' {
        ext.args = "'join_keys=[meta_batch,meta_well,meta_tile,meta_cell_index]' feature_selector=features"
        publishDir = [path: { "${params.pipeline_dir}/ovwt_batchwise_cp_features/${batch_stem}" }, mode: 'copy']
    }
}
