// Per-process settings of the shared modules (../../nextflow/modules/local/<stage>/main.nf)
// as this pipeline runs them: each process's `python -m` entry point (ext.entry), the
// config keys its inputs bind to, pipeline-specific overrides (ext.args) and publish path.
// The modules themselves carry only what both pipelines pass the same way.
//
// ext.args closures see the process's inputs (batch_stem, rep, method, ...).

process {
    withName: 'QC_FILTER' {
        ext.entry = 'fisseq_embeddings_pipeline.qcfilter'
        publishDir = [path: { "${params.pipeline_dir}/qc_filter/${batch_stem}" }, mode: 'copy']
    }

    // The shared FILTER module, once per track. The normalizer is fit on the untagged
    // synonymous variants.
    withName: 'FILTER_EMBEDDINGS' {
        ext.entry = 'fisseq_embeddings_pipeline.filter'
        ext.args = { "embeddings_file=${cells} qc_passed_file=${qc_passed}" }
        publishDir = [path: { "${params.pipeline_dir}/filter_embeddings/${batch_stem}" }, mode: 'copy']
    }
    withName: 'FILTER_CP_FEATURES' {
        ext.entry = 'fisseq_embeddings_pipeline.filter_cp_features'
        ext.args = { "cp_features_file=${cells} qc_passed_file=${qc_passed}" }
        publishDir = [path: { "${params.pipeline_dir}/filter_cp_features/${batch_stem}" }, mode: 'copy']
    }

    withName: 'OVWT_BATCHWISE' {
        ext.entry = 'fisseq_embeddings_pipeline.ovwt'
        ext.cells_key = 'embeddings_file'
        publishDir = [path: { "${params.pipeline_dir}/ovwt_batchwise/${batch_stem}" }, mode: 'copy']
    }
    withName: 'OVWT_BATCHWISE_CP_FEATURES' {
        ext.entry = 'fisseq_embeddings_pipeline.ovwt_cp_features'
        ext.cells_key = 'cp_features_file'
        publishDir = [path: { "${params.pipeline_dir}/ovwt_batchwise_cp_features/${batch_stem}" }, mode: 'copy']
    }

    withName: 'GENERATE_SPLIT' {
        ext.entry = 'fisseq_embeddings_pipeline.generatesplit'
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/splits/rep${rep}" }, mode: 'copy']
    }

    // The shared AGGREGATE_HALF module, twice: one bootstrap half, and (no split file) a
    // passthrough method over every cell. bare_columns: a median job writes bare emb_*
    // columns only when the run's whole aggregate_methods list is ["median"], matching
    // AGGREGATE_EMBEDDINGS' aggregate.parquet, whose column names the blocklist keys on.
    withName: 'AGGREGATE_HALF' {
        ext.entry = 'fisseq_embeddings_pipeline.aggregate_half'
        ext.cells_key = 'embeddings_file'
        ext.split_key = 'split_file'
        ext.args = { "bare_columns=${(params.aggregate_methods as List) == ['median']}" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/half_aggregates/rep${rep}/half${half}" }, mode: 'copy']
    }
    withName: 'AGGREGATE_PASSTHROUGH' {
        ext.entry = 'fisseq_embeddings_pipeline.aggregate_half'
        ext.cells_key = 'embeddings_file'
        ext.split_key = 'split_file'
        ext.args = { "bare_columns=${(params.aggregate_methods as List) == ['median']}" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/passthrough_aggregates" }, mode: 'copy']
    }

    withName: 'CORRELATE_FEATURES' {
        ext.entry = 'fisseq_embeddings_pipeline.correlatefeatures'
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/correlations/rep${rep}" }, mode: 'copy']
    }

    withName: 'BLOCKLIST' {
        ext.entry = 'fisseq_embeddings_pipeline.blocklist'
        ext.args = { "minimum_correlation=${params.reproducibility_min_correlation}" }
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}/blocklists" }, mode: 'copy']
    }

    withName: 'COMBINE_BLOCKLISTS' {
        ext.entry = 'fisseq_embeddings_pipeline.combineblocklists'
        publishDir = [path: { "${params.pipeline_dir}/feature_select_batchwise/${batch_stem}" }, mode: 'copy']
    }
}
